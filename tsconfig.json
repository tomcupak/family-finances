{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "useUnknownInCatchVariables": true,
    "paths": {
      "@family-finances/domains/*": ["libs/domains/src/*"],
      "@family-finances/shared": ["libs/shared/src/index"],
      "@family-finances/database": ["libs/database/src/index"],
      "@family-finances/database/testing": ["libs/database/src/testing/index"]
    }
  },
  "exclude": ["web"]
}
