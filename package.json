{
  "name": "family-finances",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "run-p \"dev:api\" \"dev:web\" --",
    "dev:api": "nest start --watch api",
    "dev:web": "cd web && vite --config vite.config.mts",
    "env:init": "cp -n .env.sample .env",
    "db": "bash ./scripts/db-tool",
    "build": "nest build",
    "build:web": "tsc -b web && cd web && vite build --config vite.config.mts",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "lint:web": "eslint -c web/eslint.config.mjs \"web/**/*.{ts,tsx}\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "orval:web": "del ./web/apps/family-finances/src/api/schema/* && orval --config ./web/orval.config.js",
    "deploy:api": "bash scripts/deploy/deploy-deb.sh api",
    "deploy:web": "bash scripts/deploy/web/deploy.sh family-finances",
    "deploy": "run-s \"deploy:api\" \"deploy:web\""
  },
  "engines": {
    "npm": ">=11.6",
    "node": ">=24.10"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.7",
    "@nestjs/core": "^11.1.7",
    "@nestjs/platform-express": "^11.1.7",
    "@nestjs/swagger": "^11.2.0",
    "axios": "^1.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "drizzle-orm": "^0.44.2",
    "pg": "^8.16.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@apinecka/eslint-config-be": "^1.0.0",
    "@apinecka/eslint-config-web": "^1.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.29.0",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.7",
    "@swc/cli": "^0.7.7",
    "@swc/core": "^1.12.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.33",
    "@types/pg": "^8.15.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vitejs/plugin-react": "^4.3.4",
    "del-cli": "^7.0.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "generate-package-json-webpack-plugin": "^2.6.0",
    "globals": "^16.2.0",
    "jest": "^30.0.2",
    "npm-run-all": "^4.1.5",
    "orval": "^7.21.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.1",
    "terser-webpack-plugin": "^5.4.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.2.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
