API_HOST=0.0.0.0
API_PORT=3000
API_TOKEN=dev-token
CORS=http://localhost:5173

POSTGRES_HOST=localhost
POSTGRES_PORT=10400
POSTGRES_DB=family_finances
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL=4

# Deploy (scripts/deploy) - your server, kept out of the repo
DEPLOY_TARGET=finances@finances.example.com
# Private key for ssh/scp (optional; empty = ssh decides: agent, ~/.ssh/config, default keys)
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# Maintainer field of the built .deb (optional)
# DEPLOY_MAINTAINER=Your Name <you@example.com>
